{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/import-plan.schema.json",
  "title": "WorldFlow Import Plan",
  "description": "Immutable Import Plan. Approval and the current state of the source and destination require Editor verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "importPlanId",
    "revision",
    "projectFingerprint",
    "phase2",
    "source",
    "selection",
    "output",
    "expectedGmlManifestHash",
    "sdkVersion",
    "expiresAt",
    "operationKey",
    "planHash"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "importPlanId": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/uuid"},
    "revision": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/revision"},
    "projectFingerprint": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"},
    "phase2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planningSessionId", "planRevision", "planDigest"],
      "properties": {
        "planningSessionId": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/uuid"},
        "planRevision": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/revision"},
        "planDigest": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "worldFlowDatasetId", "sdkSourceId", "datasetVersion", "sourceFingerprint", "mappingStatus"],
      "properties": {
        "kind": {"enum": ["LOCAL", "REMOTE"]},
        "worldFlowDatasetId": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/id"},
        "sdkSourceId": {"anyOf": [{"type": "null"}, {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/id"}]},
        "datasetVersion": {"anyOf": [{"type": "null"}, {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/safeText"}]},
        "sourceFingerprint": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"},
        "mappingStatus": {"const": "VERIFIED"}
      },
      "if": {"properties": {"kind": {"const": "REMOTE"}}},
      "then": {"properties": {"sdkSourceId": {"type": "string"}}},
      "else": {"properties": {"sdkSourceId": {"const": null}}}
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gridCodes", "coordinateZoneId", "featureSettings", "qualityRequirementsStatus"],
      "properties": {
        "gridCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/grid"}
        },
        "coordinateZoneId": {"type": "integer", "minimum": 1, "maximum": 19},
        "featureSettings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/featureSettings"}
        },
        "qualityRequirementsStatus": {"const": "VERIFIED"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "scenePath", "assetExport", "overwriteExisting"],
      "properties": {
        "mode": {"const": "NEW_SCENE"},
        "scenePath": {
          "type": "string",
          "pattern": "^(?:Assets/PLATEAUWorldFlow/Imports/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/City\\.unity)(?![\\s\\S])"
        },
        "assetExport": {"const": "NONE"},
        "overwriteExisting": {"const": false}
      }
    },
    "expectedGmlManifestHash": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"},
    "sdkVersion": {"const": "4.3.0"},
    "expiresAt": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/timestamp"},
    "operationKey": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"},
    "planHash": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/hash"}
  },
  "$defs": {
    "featureSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureType", "lods", "includeTexture", "enableTexturePacking", "doSetMeshCollider", "doSetAttrInfo", "meshGranularity"],
      "properties": {
        "featureType": {"$ref": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json#/$defs/id"},
        "lods": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2147483647}},
        "includeTexture": {"type": "boolean"},
        "enableTexturePacking": {"type": "boolean"},
        "doSetMeshCollider": {"type": "boolean"},
        "doSetAttrInfo": {"type": "boolean"},
        "meshGranularity": {"enum": ["PerAtomicFeatureObject", "PerPrimaryFeatureObject", "PerCityModelArea"]}
      },
      "if": {"properties": {"includeTexture": {"const": false}}},
      "then": {"properties": {"enableTexturePacking": {"const": false}}}
    }
  }
}
