{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/readonly-response.schema.json",
  "title": "Phase 1 Read-only Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "projectFingerprint",
    "operation",
    "status",
    "checkedAt",
    "result",
    "evidence",
    "diagnostics",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "requestId": {"$ref": "#/$defs/uuid"},
    "projectFingerprint": {"$ref": "#/$defs/hash"},
    "operation": {
      "enum": [
        "dependencies.inspect",
        "datasets.list",
        "coverage.inspect",
        "areas.plan",
        "areas.preview",
        "areas.preview_png"
      ]
    },
    "status": {"enum": ["READY", "PARTIAL", "UNAVAILABLE", "UNKNOWN", "BLOCKED", "FAILED"]},
    "checkedAt": {"$ref": "#/$defs/timestamp"},
    "result": {"type": ["object", "null"]},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}, "maxItems": 16, "uniqueItems": true},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}, "maxItems": 16, "uniqueItems": true},
    "warnings": {
      "type": "array",
      "items": {"enum": ["CRS_UNVERIFIED", "LIMIT_EXCEEDED", "COVERAGE_UNCONFIRMED"]},
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "dependencies.inspect"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["inventoryRef", "dependencyStatus", "inspectedAt"],
                "properties": {
                  "inventoryRef": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
                  "dependencyStatus": {"enum": ["READY", "MISSING", "INCOMPATIBLE", "BLOCKED", "UNKNOWN"]},
                  "inspectedAt": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "datasets.list"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "datasets", "truncated"],
                "properties": {
                  "source": {"$ref": "#/$defs/source"},
                  "datasets": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {"$ref": "#/$defs/dataset"},
                        "maxItems": 20,
                        "uniqueItems": true
                      },
                      {"type": "null"}
                    ]
                  },
                  "truncated": {"type": "boolean"}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "coverage.inspect"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "datasetId",
                  "availableGridCodes",
                  "unavailableGridCodes",
                  "unverifiedGridCodes",
                  "truncated"
                ],
                "properties": {
                  "datasetId": {"$ref": "#/$defs/id"},
                  "availableGridCodes": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {"$ref": "#/$defs/cell"},
                        "maxItems": 500,
                        "uniqueItems": true
                      },
                      {"type": "null"}
                    ]
                  },
                  "unavailableGridCodes": {"anyOf": [{"$ref": "#/$defs/grids"}, {"type": "null"}]},
                  "unverifiedGridCodes": {"$ref": "#/$defs/grids"},
                  "truncated": {"type": "boolean"}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "areas.plan"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "planId",
                  "planRevision",
                  "coverageSnapshotId",
                  "selectedGridCodes",
                  "coveredGridCodes",
                  "missingGridCodes",
                  "unverifiedGridCodes",
                  "extent",
                  "overlap",
                  "estimatedAreaSquareMeters",
                  "areaMethod"
                ],
                "properties": {
                  "planId": {"$ref": "#/$defs/uuid"},
                  "planRevision": {"$ref": "#/$defs/revision"},
                  "coverageSnapshotId": {"$ref": "#/$defs/uuid"},
                  "selectedGridCodes": {"$ref": "#/$defs/grids", "minItems": 1},
                  "coveredGridCodes": {"$ref": "#/$defs/grids"},
                  "missingGridCodes": {"$ref": "#/$defs/grids"},
                  "unverifiedGridCodes": {"$ref": "#/$defs/grids"},
                  "extent": {"anyOf": [{"$ref": "#/$defs/extent"}, {"type": "null"}]},
                  "overlap": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {"$ref": "#/$defs/overlap"},
                        "maxItems": 500,
                        "uniqueItems": true
                      },
                      {"type": "null"}
                    ]
                  },
                  "estimatedAreaSquareMeters": {"anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
                  "areaMethod": {"enum": ["EXACT_PROJECTED", "APPROX_PROJECTED", "NOT_COMPUTED"]}
                },
                "allOf": [
                  {
                    "if": {"properties": {"areaMethod": {"const": "NOT_COMPUTED"}}},
                    "then": {"properties": {"estimatedAreaSquareMeters": {"type": "null"}}},
                    "else": {
                      "properties": {"estimatedAreaSquareMeters": {"type": "number", "exclusiveMinimum": 0}}
                    }
                  }
                ]
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "areas.preview"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["previewId", "extent", "coordinateReference", "gridCells", "legend", "accuracyNote"],
                "properties": {
                  "previewId": {"$ref": "#/$defs/uuid"},
                  "extent": {"anyOf": [{"$ref": "#/$defs/extent"}, {"type": "null"}]},
                  "coordinateReference": {"$ref": "#/$defs/crs"},
                  "gridCells": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["code", "extent", "availability", "selected"],
                      "properties": {
                        "code": {"$ref": "#/$defs/grid"},
                        "extent": {"anyOf": [{"$ref": "#/$defs/extent"}, {"type": "null"}]},
                        "availability": {"$ref": "#/$defs/availability"},
                        "selected": {"type": "boolean"}
                      }
                    },
                    "maxItems": 500,
                    "uniqueItems": true
                  },
                  "legend": {
                    "type": "array",
                    "items": {"$ref": "#/$defs/availability"},
                    "maxItems": 3,
                    "uniqueItems": true
                  },
                  "accuracyNote": {"enum": ["SCHEMATIC", "CRS_UNVERIFIED"]}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"const": "areas.preview_png"}}},
      "then": {
        "properties": {
          "result": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifactId",
                  "relativePath",
                  "mimeType",
                  "width",
                  "height",
                  "sha256",
                  "byteLength",
                  "createdAt",
                  "sourceDatasetId",
                  "planId",
                  "planRevision",
                  "crs",
                  "deliveryStatus"
                ],
                "properties": {
                  "artifactId": {"$ref": "#/$defs/uuid"},
                  "relativePath": {
                    "type": "string",
                    "pattern": "^(?:Library/PLATEAUWorldFlow/Preview/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.png)(?![\\s\\S])"
                  },
                  "mimeType": {"const": "image/png"},
                  "width": {"$ref": "#/$defs/dimension"},
                  "height": {"$ref": "#/$defs/dimension"},
                  "sha256": {"$ref": "#/$defs/hash"},
                  "byteLength": {"type": "integer", "minimum": 1, "maximum": 2147483647},
                  "createdAt": {"$ref": "#/$defs/timestamp"},
                  "sourceDatasetId": {"$ref": "#/$defs/id"},
                  "planId": {"$ref": "#/$defs/uuid"},
                  "planRevision": {"$ref": "#/$defs/revision"},
                  "crs": {"$ref": "#/$defs/crs"},
                  "deliveryStatus": {"enum": ["INLINE_IMAGE", "ARTIFACT_ONLY", "UNAVAILABLE"]}
                }
              },
              {"type": "null"}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["READY", "PARTIAL"]}}},
      "then": {"properties": {"result": {"type": "object"}}}
    },
    {
      "if": {"properties": {"status": {"const": "READY"}}},
      "then": {"properties": {"diagnostics": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"not": {"const": "READY"}}}},
      "then": {"properties": {"diagnostics": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["BLOCKED", "FAILED"]}}},
      "then": {"properties": {"result": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "UNAVAILABLE"}}},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"result": {"type": "object"}}},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63})(?![\\s\\S])",
      "not": {
        "pattern": "[Gg][Hh][PpOoUuSsRr]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Ss][Kk]-|[Aa][Kk][Ii][Aa][A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{8}|[Bb][Ee][Aa][Rr][Ee][Rr][ _-]"
      }
    },
    "uuid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])"
    },
    "hash": {"type": "string", "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"},
    "source": {"enum": ["LOCAL", "REMOTE"]},
    "grid": {"type": "string", "pattern": "^(?:[0-9]{4}(?:[0-7]{2}(?:[0-9]{2}[1-4]{0,3})?)?)(?![\\s\\S])"},
    "crs": {"anyOf": [{"type": "string", "pattern": "^(?:EPSG:[1-9][0-9]{0,5})(?![\\s\\S])"}, {"type": "null"}]},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "dimension": {"type": "integer", "minimum": 1, "maximum": 1024},
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)(?![\\s\\S])",
      "format": "date-time"
    },
    "safeText": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9\\u3000-\\u30ff\\u3400-\\u9fff\\uFF10-\\uFF19\\uFF08][A-Za-z0-9\\u3000-\\u30ff\\u3400-\\u9fff\\uFF10-\\uFF19\\uFF08\\uFF09 ._()・-]{0,127})(?![\\s\\S])",
      "not": {
        "pattern": "[Gg][Hh][PpOoUuSsRr]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Ss][Kk]-|[Aa][Kk][Ii][Aa][A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{8}|[Bb][Ee][Aa][Rr][Ee][Rr][ _-]"
      },
      "allOf": [{"not": {"pattern": "\\.\\."}}]
    },
    "officialUrl": {
      "type": "string",
      "pattern": "^(?:https://(?:www\\.mlit\\.go\\.jp|www\\.geospatial\\.jp|www\\.gsi\\.go\\.jp|www\\.creativecommons\\.org|creativecommons\\.org|www\\.digital\\.go\\.jp)(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*/?)(?![\\s\\S])",
      "not": {
        "pattern": "[Gg][Hh][PpOoUuSsRr]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Ss][Kk]-|[Aa][Kk][Ii][Aa][A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{8}|[Bb][Ee][Aa][Rr][Ee][Rr][ _-]"
      },
      "maxLength": 256
    },
    "grids": {"type": "array", "items": {"$ref": "#/$defs/grid"}, "maxItems": 500, "uniqueItems": true},
    "featureTypes": {
      "anyOf": [
        {"type": "array", "items": {"$ref": "#/$defs/id"}, "maxItems": 64, "uniqueItems": true},
        {"type": "null"}
      ]
    },
    "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNVERIFIED"]},
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["south", "west", "north", "east", "crs"],
      "properties": {
        "south": {"type": "number", "minimum": -90, "maximum": 90},
        "west": {"type": "number", "minimum": -180, "maximum": 180},
        "north": {"type": "number", "minimum": -90, "maximum": 90},
        "east": {"type": "number", "minimum": -180, "maximum": 180},
        "crs": {"$ref": "#/$defs/crs"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "featureTypes",
        "title",
        "version",
        "publisher",
        "licenseId",
        "licenseUrl",
        "sourceUrl"
      ],
      "properties": {
        "datasetId": {"$ref": "#/$defs/id"},
        "featureTypes": {"$ref": "#/$defs/featureTypes"},
        "title": {"anyOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "version": {"anyOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "publisher": {"anyOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "licenseId": {"anyOf": [{"$ref": "#/$defs/safeText"}, {"type": "null"}]},
        "licenseUrl": {"anyOf": [{"$ref": "#/$defs/officialUrl"}, {"type": "null"}]},
        "sourceUrl": {"anyOf": [{"$ref": "#/$defs/officialUrl"}, {"type": "null"}]}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "extent", "featureTypes", "availableLods"],
      "properties": {
        "code": {"$ref": "#/$defs/grid"},
        "extent": {"$ref": "#/$defs/extent"},
        "featureTypes": {"$ref": "#/$defs/featureTypes"},
        "availableLods": {
          "anyOf": [
            {
              "type": "array",
              "items": {"type": "integer", "minimum": 0, "maximum": 2147483647},
              "maxItems": 64,
              "uniqueItems": true
            },
            {"type": "null"}
          ]
        }
      }
    },
    "overlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["areaIds", "gridCodes", "estimatedAreaSquareMeters"],
      "properties": {
        "areaIds": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "maxItems": 500, "uniqueItems": true},
        "gridCodes": {"$ref": "#/$defs/grids"},
        "estimatedAreaSquareMeters": {"anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "location", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "SDK_NOT_READY",
            "DATASET_NOT_FOUND",
            "COVERAGE_UNCONFIRMED",
            "COVERAGE_NOT_FOUND",
            "INVALID_GRID_CODE",
            "INVALID_INPUT",
            "CRS_UNVERIFIED",
            "LONGITUDE_BOUNDARY",
            "NETWORK_UNAVAILABLE",
            "NATIVE_FAILURE",
            "SOURCE_NOT_ALLOWED",
            "PROJECT_MISMATCH",
            "PLAN_STALE",
            "LIMIT_EXCEEDED",
            "CAPABILITY_UNAVAILABLE",
            "ARTIFACT_WRITE_FAILED"
          ]
        },
        "location": {
          "enum": [
            "operation",
            "input",
            "projectFingerprint",
            "sourceReference",
            "source",
            "maxResults",
            "datasetId",
            "gridCodes",
            "selectedGridCodes",
            "coordinateReference",
            "coverageSnapshotId",
            "extent",
            "inventoryRef",
            "planId",
            "planRevision",
            "previewId",
            "width",
            "height",
            "relativePath"
          ]
        },
        "retryable": {"type": "boolean"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "checkedAt"],
      "properties": {
        "kind": {"enum": ["DATASET_QUERY", "DEPENDENCY_INVENTORY", "AREA_PREVIEW", "PNG_ARTIFACT"]},
        "source": {
          "anyOf": [
            {"enum": ["LOCAL_DATASET", "REMOTE_DATASET", "LOCAL_PROJECT"]},
            {"$ref": "#/$defs/officialUrl"}
          ]
        },
        "checkedAt": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
