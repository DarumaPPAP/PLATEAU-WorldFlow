{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/dependency-install-plan.schema.json",
  "title": "Dependency Install Plan",
  "description": "Phase 0 wire contract v1. Unknown properties are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectFingerprint",
    "planId",
    "revision",
    "planHash",
    "createdAt",
    "expiresAt",
    "baselineManifestHash",
    "baselineLockHash",
    "changes",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "projectFingerprint": {
      "$ref": "#/$defs/hash"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "planHash": {
      "$ref": "#/$defs/hash"
    },
    "createdAt": {
      "$ref": "#/$defs/date"
    },
    "expiresAt": {
      "$ref": "#/$defs/date"
    },
    "baselineManifestHash": {
      "$ref": "#/$defs/hash"
    },
    "baselineLockHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId",
          "sourceUri",
          "versionOrCommit",
          "expectedVersion",
          "reason",
          "licenseUrl"
        ],
        "properties": {
          "packageId": {
            "$ref": "#/$defs/packageId"
          },
          "sourceUri": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/[A-Za-z0-9._/-]+#[A-Za-z0-9._-]+(?![\\s\\S])",
            "maxLength": 512
          },
          "versionOrCommit": {
            "type": "string",
            "pattern": "^(?:v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?|[0-9a-f]{40})(?![\\s\\S])",
            "maxLength": 128
          },
          "expectedVersion": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._+-]{0,127}(?![\\s\\S])",
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])",
            "maxLength": 512
          },
          "licenseUrl": {
            "type": "string",
            "pattern": "^https://[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+/[A-Za-z0-9._/-]+(?![\\s\\S])",
            "maxLength": 512
          }
        }
      },
      "minItems": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+(?![\\s\\S])",
        "maxLength": 512
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "maxLength": 64
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])",
      "maxLength": 20,
      "format": "date-time"
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9][a-z0-9_-]*){2,}(?![\\s\\S])",
      "maxLength": 128
    }
  }
}
