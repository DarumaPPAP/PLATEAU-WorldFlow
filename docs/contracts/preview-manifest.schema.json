{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darumappap.github.io/PLATEAU-WorldFlow/contracts/v1/preview-manifest.schema.json",
  "title": "WorldFlow Preview Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "relativePath",
    "mimeType",
    "width",
    "height",
    "sha256",
    "byteLength",
    "createdAt",
    "sourceDatasetId",
    "planId",
    "planRevision",
    "crs",
    "deliveryStatus",
    "source",
    "sourceReference",
    "extent"
  ],
  "properties": {
    "artifactId": {
      "$ref": "#/$defs/uuid"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?:Library/PLATEAUWorldFlow/Preview/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.png)(?![\\s\\S])"
    },
    "mimeType": {
      "const": "image/png"
    },
    "width": {
      "$ref": "#/$defs/dimension"
    },
    "height": {
      "$ref": "#/$defs/dimension"
    },
    "sha256": {
      "$ref": "#/$defs/hash"
    },
    "byteLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "sourceDatasetId": {
      "$ref": "#/$defs/id"
    },
    "planId": {
      "$ref": "#/$defs/uuid"
    },
    "planRevision": {
      "$ref": "#/$defs/revision"
    },
    "crs": {
      "$ref": "#/$defs/crs"
    },
    "deliveryStatus": {
      "enum": [
        "INLINE_IMAGE",
        "ARTIFACT_ONLY",
        "UNAVAILABLE"
      ]
    },
    "source": {
      "enum": [
        "LOCAL_DATASET",
        "REMOTE_DATASET"
      ]
    },
    "sourceReference": {
      "$ref": "#/$defs/id"
    },
    "extent": {
      "anyOf": [
        {
          "$ref": "#/$defs/extent"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})(?![\\s\\S])"
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "hash": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{64})(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)(?![\\s\\S])",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{0,63})(?![\\s\\S])",
      "not": {
        "pattern": "[Gg][Hh][PpOoUuSsRr]_|[Gg][Ii][Tt][Hh][Uu][Bb]_[Pp][Aa][Tt]_|[Ss][Kk]-|[Aa][Kk][Ii][Aa][A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{8}|[Bb][Ee][Aa][Rr][Ee][Rr][ _-]"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "crs": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:EPSG:[1-9][0-9]{0,5})(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "extent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "south",
        "west",
        "north",
        "east",
        "crs"
      ],
      "properties": {
        "south": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "west": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "north": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "east": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "crs": {
          "$ref": "#/$defs/crs"
        }
      }
    }
  }
}
